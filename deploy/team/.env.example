# Libre WebUI team profile (PostgreSQL/PGVector + MinIO + Redis + external jobs).
#
# Copy this file outside the repository, replace every REPLACE_* value, and
# protect the completed file with mode 0600. The placeholders are deliberately
# invalid for production; do not deploy them unchanged.

# Source checkouts build this local tag with `docker compose ... up --build`.
# Published deployments should replace it with an immutable image digest.
LIBRE_TEAM_IMAGE=libre-webui:team
PORT=8080
ENABLE_SIGNUP=false

# Generate URL-safe PostgreSQL credentials, for example: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_POSTGRES_PASSWORD
MINIO_ROOT_USER=REPLACE_WITH_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_WITH_MINIO_SECRET_KEY
JWT_SECRET=REPLACE_WITH_64_HEX_JWT_SECRET

# Every encryption key is exactly 64 hexadecimal characters (32 bytes).
# On a fresh install, `legacy` must equal ENCRYPTION_KEY. During a SQLite
# migration, both values must equal the source installation's ENCRYPTION_KEY.
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_LEGACY_KEY
STORAGE_ENCRYPTION_ACTIVE_KEY_ID=primary-2026
STORAGE_ENCRYPTION_KEYS={"legacy":"REPLACE_WITH_64_HEX_LEGACY_KEY","primary-2026":"REPLACE_WITH_DIFFERENT_64_HEX_ACTIVE_KEY"}

POSTGRES_MIGRATION_MODE=apply
POSTGRES_POOL_MAX=10
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
POSTGRES_MIGRATION_LOCK_TIMEOUT_MS=60000
REDIS_CONNECT_TIMEOUT_MS=5000

BLOB_QUOTA_BYTES_PER_USER=10737418240
BLOB_QUOTA_RESERVATION_TTL_MS=3600000

# Docker Desktop resolves host.docker.internal automatically. Linux operators
# must expose Ollama through a reviewed reachable address or Compose override.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT=300000
OLLAMA_LONG_OPERATION_TIMEOUT=900000
OLLAMA_MAX_CONTEXT=32768
