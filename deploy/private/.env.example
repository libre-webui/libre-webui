LIBRE_WEBUI_IMAGE=ghcr.io/libre-webui/libre-webui:main
PUBLIC_HOSTNAME=chat.example.com
ENABLE_SIGNUP=false
# Required only when docker-compose.work.yml is enabled.
DOCKER_GID=998

# Generate once and store in a root-owned 0600 .env file.
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-64-character-hex-value
SEARXNG_SECRET=replace-with-a-long-random-value
TURNSTILE_SITE_KEY=replace-with-your-site-key
TURNSTILE_SECRET_KEY=replace-with-your-secret-key
TURNSTILE_EXPECTED_HOSTNAME=chat.example.com

# Stop idle Work sandboxes (previews included) after this many milliseconds.
# Default 30 minutes; set 0 to let previews run until stopped explicitly.
WORK_RUNTIME_IDLE_TIMEOUT_MS=1800000

# Per-user stored-blob quota and abandoned-reservation expiry. The default
# quota is 10 GiB; set the byte limit deliberately for the host's capacity.
BLOB_QUOTA_BYTES_PER_USER=10737418240
BLOB_QUOTA_RESERVATION_TTL_MS=3600000

# Container admission limits. Tune for the host instead of removing them.
LIBRE_WEBUI_MEMORY_LIMIT=4g
LIBRE_WEBUI_CPU_LIMIT=4
LIBRE_WEBUI_PIDS_LIMIT=512
OLLAMA_MEMORY_LIMIT=12g
OLLAMA_CPU_LIMIT=8
OLLAMA_PIDS_LIMIT=1024
