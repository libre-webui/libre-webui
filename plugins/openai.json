{
  "id": "openai",
  "name": "OpenAI GPT",
  "type": "completion",
  "endpoint": "https://api.openai.com/v1/chat/completions",
  "auth": {
    "header": "Authorization",
    "prefix": "Bearer ",
    "key_env": "OPENAI_API_KEY"
  },
  "model_map": [
    "chatgpt-4o-latest",
    "gpt-4.1",
    "gpt-4.1-mini",
    "gpt-4.1-nano",
    "gpt-4o",
    "gpt-4o-mini",
    "gpt-5",
    "gpt-5-chat-latest",
    "gpt-5-mini",
    "gpt-5-nano",
    "gpt-5-pro",
    "gpt-5.1",
    "gpt-5.1-chat-latest",
    "gpt-5.1-codex",
    "gpt-5.2",
    "gpt-5.2-chat-latest",
    "gpt-5.2-pro",
    "gpt-5.4",
    "gpt-5.4-mini",
    "gpt-5.4-nano",
    "gpt-5.5",
    "o1",
    "o1-pro",
    "o3",
    "o3-mini",
    "o4-mini",
    "o4-mini-deep-research"
  ],
  "capabilities": {
    "tts": {
      "endpoint": "https://api.openai.com/v1/audio/speech",
      "model_map": [
        "tts-1",
        "tts-1-hd",
        "gpt-4o-mini-tts",
        "gpt-4o-mini-tts-2025-03-20",
        "gpt-4o-mini-tts-2025-12-15"
      ],
      "config": {
        "voices": [
          "alloy",
          "ash",
          "coral",
          "echo",
          "fable",
          "onyx",
          "nova",
          "sage",
          "shimmer"
        ],
        "default_voice": "alloy",
        "formats": ["mp3", "opus", "aac", "flac", "wav", "pcm"],
        "default_format": "mp3",
        "max_characters": 4096,
        "supports_streaming": true
      }
    }
  },
  "variables": [
    {
      "name": "endpoint",
      "type": "string",
      "label": "API Endpoint",
      "description": "Override the default API endpoint URL.",
      "default": "https://api.openai.com/v1/chat/completions"
    },
    {
      "name": "temperature",
      "type": "number",
      "label": "Temperature",
      "description": "Controls randomness. Lower values are more focused, higher values more creative.",
      "default": 0.7,
      "min": 0,
      "max": 2
    },
    {
      "name": "max_tokens",
      "type": "number",
      "label": "Max Tokens",
      "description": "Maximum number of tokens to generate in the response.",
      "default": 4096,
      "min": 1,
      "max": 128000
    },
    {
      "name": "top_p",
      "type": "number",
      "label": "Top P",
      "description": "Nucleus sampling. Lower values make output more focused.",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "frequency_penalty",
      "type": "number",
      "label": "Frequency Penalty",
      "description": "Reduces repetition of frequent tokens.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "presence_penalty",
      "type": "number",
      "label": "Presence Penalty",
      "description": "Encourages the model to talk about new topics.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "stream",
      "type": "boolean",
      "label": "Stream Response",
      "description": "Stream the response token by token.",
      "default": true
    }
  ]
}
