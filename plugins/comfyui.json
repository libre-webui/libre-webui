{
  "id": "comfyui",
  "name": "ComfyUI Flux",
  "type": "image",
  "endpoint": "http://localhost:8189/prompt",
  "auth": {
    "header": "X-ComfyUI-Auth",
    "prefix": "",
    "key_env": "COMFYUI_API_KEY",
    "optional": true
  },
  "model_map": [
    "flux1-dev",
    "flux1-dev-fp8",
    "flux1-schnell"
  ],
  "capabilities": {
    "image": {
      "endpoint": "http://localhost:8189/prompt",
      "model_map": [
        "flux1-dev",
        "flux1-dev-fp8",
        "flux1-schnell"
      ],
      "config": {
        "sizes": [
          "512x512",
          "512x768",
          "768x512",
          "768x768",
          "768x1024",
          "1024x768",
          "1024x1024",
          "1024x1280",
          "1280x1024",
          "1280x720",
          "720x1280",
          "1920x1080",
          "1080x1920"
        ],
        "default_size": "1024x1024",
        "qualities": [
          "draft",
          "standard",
          "high",
          "ultra"
        ],
        "default_quality": "standard",
        "max_prompt_length": 2000,
        "no_auth_required": true
      }
    }
  },
  "variables": [
    {
      "name": "steps",
      "type": "number",
      "label": "Steps",
      "description": "Number of sampling steps. More steps = higher quality but slower.",
      "default": 20,
      "min": 1,
      "max": 150
    },
    {
      "name": "cfg_scale",
      "type": "number",
      "label": "CFG Scale",
      "description": "Classifier-free guidance scale. Higher values follow the prompt more closely.",
      "default": 7,
      "min": 1,
      "max": 30
    },
    {
      "name": "seed",
      "type": "number",
      "label": "Seed",
      "description": "Random seed for reproducibility. Use -1 for random.",
      "default": -1,
      "min": -1,
      "max": 2147483647
    }
  ]
}
