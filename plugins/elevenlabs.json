{
  "id": "elevenlabs",
  "name": "ElevenLabs",
  "type": "tts",
  "endpoint": "https://api.elevenlabs.io/v1/text-to-speech/{voice_id}",
  "auth": {
    "header": "xi-api-key",
    "key_env": "ELEVENLABS_API_KEY"
  },
  "model_map": [
    "eleven_multilingual_v2",
    "eleven_turbo_v2_5",
    "eleven_turbo_v2",
    "eleven_monolingual_v1",
    "eleven_multilingual_v1",
    "eleven_flash_v2_5",
    "eleven_flash_v2"
  ],
  "capabilities": {
    "tts": {
      "endpoint": "https://api.elevenlabs.io/v1/text-to-speech",
      "model_map": [
        "eleven_multilingual_v2",
        "eleven_turbo_v2_5",
        "eleven_turbo_v2",
        "eleven_monolingual_v1",
        "eleven_multilingual_v1",
        "eleven_flash_v2_5",
        "eleven_flash_v2"
      ],
      "config": {
        "voices": [
          "Rachel",
          "Domi",
          "Bella",
          "Antoni",
          "Elli",
          "Josh",
          "Arnold",
          "Adam",
          "Sam",
          "Nicole",
          "Glinda",
          "Clyde",
          "James",
          "Charlotte",
          "Lily",
          "Serena"
        ],
        "default_voice": "Rachel",
        "formats": [
          "mp3",
          "pcm",
          "ulaw"
        ],
        "default_format": "mp3",
        "max_characters": 5000,
        "supports_streaming": true
      }
    }
  },
  "variables": [
    {
      "name": "endpoint",
      "type": "string",
      "label": "API Endpoint",
      "description": "Override the default API endpoint URL.",
      "default": "https://api.elevenlabs.io/v1/text-to-speech/{voice_id}"
    },
    {
      "name": "stability",
      "type": "number",
      "label": "Stability",
      "description": "Voice stability (0-1). Higher values are more consistent.",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "name": "similarity_boost",
      "type": "number",
      "label": "Similarity Boost",
      "description": "Voice similarity boost (0-1).",
      "default": 0.75,
      "min": 0,
      "max": 1
    },
    {
      "name": "speed",
      "type": "number",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4
    }
  ]
}
