{
  "id": "openai-tts",
  "name": "OpenAI TTS",
  "type": "tts",
  "endpoint": "https://api.openai.com/v1/audio/speech",
  "auth": {
    "header": "Authorization",
    "prefix": "Bearer ",
    "key_env": "OPENAI_API_KEY"
  },
  "model_map": [
    "gpt-4o-mini-tts",
    "tts-1",
    "tts-1-hd"
  ],
  "capabilities": {
    "tts": {
      "endpoint": "https://api.openai.com/v1/audio/speech",
      "model_map": [
        "gpt-4o-mini-tts",
        "tts-1",
        "tts-1-hd"
      ],
      "config": {
        "voices": [
          "alloy",
          "ash",
          "coral",
          "echo",
          "fable",
          "onyx",
          "nova",
          "sage",
          "shimmer"
        ],
        "default_voice": "alloy",
        "formats": [
          "mp3",
          "opus",
          "aac",
          "flac",
          "wav",
          "pcm"
        ],
        "default_format": "mp3",
        "max_characters": 4096,
        "supports_streaming": true
      }
    }
  },
  "variables": [
    {
      "name": "endpoint",
      "type": "string",
      "label": "API Endpoint",
      "description": "Override the default API endpoint URL.",
      "default": "https://api.openai.com/v1/audio/speech"
    },
    {
      "name": "speed",
      "type": "number",
      "label": "Speed",
      "description": "Playback speed multiplier.",
      "default": 1,
      "min": 0.25,
      "max": 4
    }
  ]
}
