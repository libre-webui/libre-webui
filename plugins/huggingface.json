  "description": "Access 1M+ models via HuggingFace Inference Providers. Billing centralized on your HF account.",
  "documentation_url": "https://huggingface.co/docs/inference-providers",
  "capabilities": {
    "tts": {
      "endpoint": "https://router.huggingface.co/hf-inference/models/{model}",
      "model_map": [
        "facebook/mms-tts-eng",
        "facebook/mms-tts-fra",
        "facebook/mms-tts-deu",
        "facebook/mms-tts-spa",
        "coqui/XTTS-v2",
        "suno/bark",
        "suno/bark-small",
        "parler-tts/parler-tts-mini-v1",
        "parler-tts/parler-tts-large-v1",
        "OuteAI/OuteTTS-0.3-1B"
      ],
      "config": {
        "endpoint_variable": "tts_endpoint",
        "voices": ["default"],
        "default_voice": "default",
        "formats": ["flac", "wav", "mp3"],
        "default_format": "flac",
        "max_characters": 5000,
        "supports_streaming": false
      }
    },
    "image": {
      "endpoint": "https://router.huggingface.co/hf-inference/models/{model}",
      "model_map": [
        "black-forest-labs/FLUX.1-dev",
        "black-forest-labs/FLUX.1-schnell",
        "stabilityai/stable-diffusion-xl-base-1.0",
        "stabilityai/stable-diffusion-3.5-large",
        "stabilityai/stable-diffusion-3.5-large-turbo",
        "stabilityai/stable-diffusion-3-medium",
        "runwayml/stable-diffusion-v1-5",
        "CompVis/stable-diffusion-v1-4",
        "prompthero/openjourney-v4",
        "segmind/SSD-1B"
      ],
      "config": {
        "endpoint_variable": "image_endpoint",
        "sizes": ["512x512", "768x768", "1024x1024", "1024x768", "768x1024"],
        "default_size": "1024x1024",
        "qualities": ["standard", "high"],
        "default_quality": "standard",
        "max_prompt_length": 2000
      }
    },
    "embedding": {
      "endpoint": "https://router.huggingface.co/hf-inference/models/{model}",
      "model_map": [
        "sentence-transformers/all-MiniLM-L6-v2",
        "sentence-transformers/all-mpnet-base-v2",
        "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
        "BAAI/bge-small-en-v1.5",
        "BAAI/bge-base-en-v1.5",
        "BAAI/bge-large-en-v1.5",
        "jinaai/jina-embeddings-v2-base-en",
        "jinaai/jina-embeddings-v2-small-en",
        "intfloat/e5-small-v2",
        "intfloat/e5-base-v2",
        "intfloat/e5-large-v2",
        "thenlper/gte-small",
        "thenlper/gte-base",
        "thenlper/gte-large"
      ],
      "config": {
        "endpoint_variable": "embedding_endpoint",
        "max_tokens": 512,
        "dimensions": {
          "sentence-transformers/all-MiniLM-L6-v2": 384,
          "sentence-transformers/all-mpnet-base-v2": 768,
          "BAAI/bge-small-en-v1.5": 384,
          "BAAI/bge-base-en-v1.5": 768,
          "BAAI/bge-large-en-v1.5": 1024
        }
      }
    },
    "stt": {
      "endpoint": "https://router.huggingface.co/hf-inference/models/{model}",
      "model_map": [
        "openai/whisper-large-v3",
        "openai/whisper-large-v3-turbo",
        "openai/whisper-medium",
        "openai/whisper-small",
        "openai/whisper-base",
        "openai/whisper-tiny",
        "facebook/wav2vec2-large-960h-lv60-self",
        "facebook/wav2vec2-base-960h",
        "nvidia/canary-1b",
        "Systran/faster-whisper-large-v3"
      ],
      "config": {
        "formats": ["wav", "webm"],
        "max_audio_bytes": 26214400,
        "max_duration_seconds": 300,
        "languages": [
          "en",
          "es",
          "fr",
          "de",
          "it",
          "pt",
          "nl",
          "ja",
          "ko",
          "zh"
        ],
        "supports_timestamps": false,
        "request_mode": "raw",
        "endpoint_variable": "stt_endpoint"
      }
    }
  },
  "variables": [
    {
      "name": "endpoint",
      "type": "string",
      "label": "API Endpoint",
      "description": "Override the default API endpoint URL.",
      "default": "https://router.huggingface.co/v1/chat/completions"
    },
    {
      "name": "tts_endpoint",
      "type": "string",
      "label": "TTS API Endpoint",
      "description": "Optional TTS endpoint template. Use {model} where the model ID belongs."
    },
    {
      "name": "stt_endpoint",
      "type": "string",
      "label": "Speech-to-Text API Endpoint",
      "description": "Optional transcription endpoint template. Use {model} where the model ID belongs."
    },
    {
      "name": "image_endpoint",
      "type": "string",
      "label": "Image API Endpoint",
      "description": "Optional image endpoint template. Use {model} where the model ID belongs."
    },
    {
      "name": "embedding_endpoint",
      "type": "string",
      "label": "Embedding API Endpoint",
      "description": "Optional embedding endpoint template. Use {model} where the model ID belongs."
    },
    {
      "name": "temperature",
      "type": "number",
      "label": "Temperature",
      "description": "Controls randomness. Lower values are more focused, higher values more creative.",
      "default": 0.7,
      "min": 0,
      "max": 2
    },
    {
      "name": "max_tokens",
      "type": "number",
      "label": "Max Tokens",
      "description": "Maximum number of tokens to generate in the response.",
      "default": 4096,
      "min": 1,
      "max": 128000
    },
    {
      "name": "top_p",
      "type": "number",
      "label": "Top P",
      "description": "Nucleus sampling. Lower values make output more focused.",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "name": "frequency_penalty",
      "type": "number",
      "label": "Frequency Penalty",
      "description": "Reduces repetition of frequent tokens.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "presence_penalty",
      "type": "number",
      "label": "Presence Penalty",
      "description": "Encourages the model to talk about new topics.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "stream",
      "type": "boolean",
      "label": "Stream Response",
      "description": "Stream the response token by token.",
      "default": true
    }
  ]
}
