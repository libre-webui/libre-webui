{
  "id": "llama-cpp",
  "name": "llama.cpp",
  "type": "completion",
  "endpoint": "http://localhost:8080/v1/chat/completions",
  "auth": {
    "header": "",
    "prefix": "",
    "key_env": ""
  },
  "model_map": [
    "qwen3-35b-a3b"
  ],
  "variables": [
    {
      "name": "endpoint",
      "type": "string",
      "label": "API Endpoint",
      "description": "llama.cpp server endpoint URL. Default: http://localhost:8080/v1/chat/completions",
      "default": "http://localhost:8080/v1/chat/completions"
    },
    {
      "name": "temperature",
      "type": "number",
      "label": "Temperature",
      "description": "Controls randomness. Qwen3 thinking-mode recommended: 0.6.",
      "default": 0.6,
      "min": 0,
      "max": 2
    },
    {
      "name": "max_tokens",
      "type": "number",
      "label": "Max Tokens",
      "description": "Maximum number of tokens to generate in the response.",
      "default": 32768,
      "min": 1,
      "max": 131072
    },
    {
      "name": "top_p",
      "type": "number",
      "label": "Top P",
      "description": "Nucleus sampling. Qwen3 thinking-mode recommended: 0.95.",
      "default": 0.95,
      "min": 0,
      "max": 1
    },
    {
      "name": "top_k",
      "type": "number",
      "label": "Top K",
      "description": "Top-K sampling. Qwen3 recommended: 20.",
      "default": 20,
      "min": 0,
      "max": 100
    },
    {
      "name": "min_p",
      "type": "number",
      "label": "Min P",
      "description": "Minimum probability threshold. Qwen3 recommended: 0.",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "name": "frequency_penalty",
      "type": "number",
      "label": "Frequency Penalty",
      "description": "Reduces repetition of frequent tokens.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "presence_penalty",
      "type": "number",
      "label": "Presence Penalty",
      "description": "Encourages the model to talk about new topics.",
      "default": 0,
      "min": -2,
      "max": 2
    },
    {
      "name": "stream",
      "type": "boolean",
      "label": "Stream Response",
      "description": "Stream the response token by token.",
      "default": true
    }
  ]
}
