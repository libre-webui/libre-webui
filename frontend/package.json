  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test:unit": "node --import tsx --test src/utils/appVersion.test.ts src/utils/config.test.ts src/utils/dataArchive.test.ts src/utils/workCode.test.ts src/utils/workEvents.test.ts src/utils/pluginEndpoint.test.ts src/utils/chatModelSelection.test.ts src/utils/modelVisibility.test.ts src/utils/imageGenModels.test.ts src/utils/api/chatEventStream.test.ts src/utils/api/workEventStream.test.ts src/utils/api/httpClient.test.ts src/utils/pluginVariableOverrides.test.ts src/utils/pluginProviderCatalog.test.ts src/utils/ttsBatching.test.ts src/utils/workDiff.test.ts src/utils/workGitDiff.test.ts src/utils/theme.test.ts src/utils/celestial.test.ts src/utils/celestialWeather.test.ts src/utils/artifactHtml.test.ts src/utils/thinkingTimer.test.ts src/utils/contextUsage.test.ts src/utils/voiceMode.test.ts src/utils/calendarDates.test.ts src/utils/automationSchedule.test.ts src/i18n/workTranslations.test.ts src/store/celestialStore.test.ts src/store/pluginStore.test.ts src/store/tabStore.test.ts",
    "e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ e2e/ playwright.config.ts --ext .ts,.tsx,.js,.jsx --max-warnings 100",
    "lint:fix": "eslint src/ e2e/ playwright.config.ts --ext .ts,.tsx,.js,.jsx --fix",
    "lint:strict": "eslint src/ e2e/ playwright.config.ts --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "build:artifact-runtime": "tsx scripts/build-artifact-runtime.mts",
    "prebuild": "npm run build:artifact-runtime",
    "predev": "npm run build:artifact-runtime"
  },
