{
  "name": "libre-webui-backend",
  "version": "0.28.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Backend API for Libre WebUI",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "start": "node dist/main.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts,.js --max-warnings 100",
    "lint:fix": "eslint src/ --ext .ts,.js --fix",
    "lint:strict": "eslint src/ --ext .ts,.js --max-warnings 0",
    "migrate": "tsx scripts/migrateFromJSON.ts",
    "recovery:check": "node dist/cli/recoveryInventory.js",
    "recovery:backup": "node dist/cli/recoveryBackup.js",
    "migrate:postgres": "node dist/cli/migrateSqliteToPostgres.js",
    "worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/lib-storage": "^3.1109.0",
    "@kubernetes/client-node": "^2.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.0.227",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "sanitize-filename": "^1.6.3",
    "undici": "^8.10.0",
    "uuid": "^14.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.10",
    "eslint": "^9.39.4",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
